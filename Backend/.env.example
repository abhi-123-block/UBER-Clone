PORT=4000
NODE_ENV=development

# MongoDB connection string
DB_CONNECT=mongodb://127.0.0.1:27017/uber-clone

# Long, random secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h

# Origin allowed to call this API with credentials (the frontend dev server).
CORS_ORIGIN=http://localhost:5173

# Optional real map/distance provider. Leave as "none" to use the built-in
# Haversine-distance fallback (no external API key needed).
MAPS_PROVIDER=none
MAPS_API_KEY=

# Optional surge pricing
SURGE_ENABLED=false
SURGE_MULTIPLIER=1.5
